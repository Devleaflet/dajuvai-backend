# Copy to .env and fill in. Never commit real values.

NODE_ENV=development
PORT=5000
PAGE_LIMIT=20
FRONTEND_URL=http://localhost:5173

# Required. The server refuses to start in production without these.
DATABASE_URL=postgresql://user:password@localhost:5432/dajuvai
JWT_SECRET=
JWT_REFRESH_SECRET=

# Shared with dajuvai_next; empty means forwarded client IPs are not trusted.
TRUSTED_PROXY_SECRET=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

# Email (Gmail SMTP). Empty disables outgoing mail.
USER_EMAIL=
PASS_EMAIL=

# Push notifications. Empty disables push.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=

# Images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# eSewa. Every payment is refused until all three are set.
ESEWA_MERCHANT=
SECRET_KEY=
ESEWA_PAYMENT_URL=

# Nepal Payment (NPX) — the gateway checkout uses.
NPX_MERCHANT_ID=
NPX_MERCHANT_NAME=
NPX_API_USERNAME=
NPX_API_PASSWORD=
NPX_SECRET_KEY=
NPX_BASE_URL=https://apigateway.nepalpayment.com
NPS_GATEWAY_URL=https://gateway.nepalpayment.com/

# Legacy NPS merchant API (GET /api/order/payment/success). No client calls it.
NPG_BASE_URL=
NPS_MERCHANT_ID=
NPS_API_USERNAME=
NPS_API_PASSWORD=
NPS_SECRET_KEY=
NPS_ACCESS_CODE=

# Push rate limits (requests per window)
PUSH_RATE_READ=300
PUSH_RATE_REGISTER=60
PUSH_RATE_SEND=120
PUSH_RATE_MULTICAST=30
PUSH_RATE_BROADCAST=15
