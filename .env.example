# Copy to .env and fill in. Never commit real values.

NODE_ENV=development
PORT=5000
PAGE_LIMIT=20
FRONTEND_URL=http://localhost:5173
# Logo shown in every email header. Defaults to the DajuVai logo on Cloudinary.
EMAIL_LOGO_URL=

# Required. The server refuses to start in production without these.
DATABASE_URL=postgresql://user:password@localhost:5432/dajuvai
JWT_SECRET=
JWT_REFRESH_SECRET=

# Shared with dajuvai_next; empty means forwarded client IPs are not trusted.
TRUSTED_PROXY_SECRET=

# OAuth (web sign-in). After sign-in the backend redirects the browser to
# <FRONTEND_URL>/auth/<provider>/callback, so FRONTEND_URL must be the Next app's
# origin (its APP_URL).
# Google Cloud console > Credentials > OAuth client (Web application):
#   Authorized redirect URI = GOOGLE_CALLBACK_URL, exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Meta for Developers > your app > Facebook Login > Settings:
#   Valid OAuth Redirect URIs = FACEBOOK_CALLBACK_URL, exactly.
#   The "email" permission must be available to the app (Use cases > Authentication).
# appsecret_proof is always sent, so "Require App Secret" may be switched on.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Empty = GOOGLE_CALLBACK_URL with /google/callback swapped for /facebook/callback.
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# Email (Gmail SMTP). Empty disables outgoing mail.
USER_EMAIL=
PASS_EMAIL=

# Push notifications. Empty disables push.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=

# Images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# eSewa. Every payment is refused until all three are set.
ESEWA_MERCHANT=
SECRET_KEY=
ESEWA_PAYMENT_URL=

# Nepal Payment (NPX) — the gateway checkout uses.
NPX_MERCHANT_ID=
NPX_MERCHANT_NAME=
NPX_API_USERNAME=
NPX_API_PASSWORD=
NPX_SECRET_KEY=
NPX_BASE_URL=https://apigateway.nepalpayment.com
NPS_GATEWAY_URL=https://gateway.nepalpayment.com/

# Legacy NPS merchant API (GET /api/order/payment/success). No client calls it.
NPG_BASE_URL=
NPS_MERCHANT_ID=
NPS_API_USERNAME=
NPS_API_PASSWORD=
NPS_SECRET_KEY=
NPS_ACCESS_CODE=

# Push rate limits (requests per window)
PUSH_RATE_READ=300
PUSH_RATE_REGISTER=60
PUSH_RATE_SEND=120
PUSH_RATE_MULTICAST=30
PUSH_RATE_BROADCAST=15

# Broadcast campaigns (admin console → Broadcasts). Nothing sends until both
# BROADCAST_ENABLED=true and a reachable REDIS_URL are set.
BROADCAST_ENABLED=false
REDIS_URL=redis://localhost:6379
# Campaign mail. Empty SMTP_HOST falls back to the Gmail account above (~500/day).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
BROADCAST_EMAIL_CONCURRENCY=5
BROADCAST_EMAIL_BATCH=50
BROADCAST_FCM_BATCH=200
BROADCAST_INAPP_BATCH=500
BROADCAST_RETRY_ATTEMPTS=3
# true: push and email are recorded as skipped instead of sent (in-app still writes).
BROADCAST_DRY_RUN=false
